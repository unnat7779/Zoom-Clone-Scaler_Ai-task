# Copy to .env.local and adjust. Every variable is read in the browser.
# FastAPI backend origin (the client adds the /api prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket origin of the same backend (signalling: /ws/meetings/{number})
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Public origin of this frontend (used to build invite links /j/{number}?pwd=…)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Plan the Schedule page imitates: "pro" (default) or "basic" (40-minute rule)
NEXT_PUBLIC_PLAN=pro
# Optional TURN server for WebRTC
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# 1 = synthetic camera/microphone (for browsers or CI without real devices)
NEXT_PUBLIC_FAKE_MEDIA=0
